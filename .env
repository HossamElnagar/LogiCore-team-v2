
MONGODB_URI=mongodb://localhost:27017/logicore

# App environment
NODE_ENV=development
PORT=3000


# ── RAG Module Toggle (set true only if Qdrant + Redis are running) ──────────
ENABLE_RAG=true

# ── MongoDB ────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/logiCore_rag
# JWT for signing auth tokens — change to a strong random value in production
JWT_SECRET=change_this_to_a_secure_random_string

# Frontend origin used for tracking links and socket CORS
CLIENT_ORIGIN=http://localhost:5173

# SMTP credentials for sending emails (leave SMTP_PASS empty for Ethereal/dev)
SMTP_USER=dev-reconciliation@logicore.com
SMTP_PASS=